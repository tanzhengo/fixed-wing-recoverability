<launch>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="paused" default="true"/>
  <arg name="voxel_resolution" default="2.0"/>
  <arg name="max_voxels" default="200000"/>
  <arg name="model_path" default="$(find motion_primitives_planning)/models/recovery_mlp.txt"/>
  <include file="$(find motion_primitives_planning)/launch/terminal_recovery.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="world_name" value="$(find simple_airplane_gazebo)/worlds/end_city_lidar.world"/>
    <arg name="task_config" value="$(find motion_primitives_planning)/launch/config/task_end_city.yaml"/>
    <arg name="description_file" value="$(find simple_airplane_description)/urdf/simple_airplane_with_3d_lidar.xacro"/>
    <arg name="rviz_config" value="$(find motion_primitives_planning)/launch/mp_end_city_lidar.rviz"/>
    <arg name="candidate_order" value="learned"/>
    <arg name="model_path" value="$(arg model_path)"/>
    <arg name="max_candidates" value="12"/>
    <arg name="learned_work_power" value="0.0"/>
    <arg name="backup_horizon" value="6.0"/>
    <arg name="stop_on_rejection" value="true"/>
    <arg name="reuse_verified_plan" value="false"/>
  </include>
  <node pkg="motion_primitives_planning" type="lidar_voxel_map.py"
        name="lidar_voxel_map" output="screen" required="true">
    <param name="resolution" value="$(arg voxel_resolution)"/>
    <param name="max_voxels" value="$(arg max_voxels)"/>
    <param name="map_publish_rate" value="2.0"/>
    <param name="min_range" value="1.0"/>
    <param name="max_range" value="120.0"/>
    <rosparam param="sensor_offset">[0.0, 0.0, 0.15]</rosparam>
    <rosparam param="sensor_rpy">[0.0, 0.0, 0.0]</rosparam>
  </node>
</launch>
