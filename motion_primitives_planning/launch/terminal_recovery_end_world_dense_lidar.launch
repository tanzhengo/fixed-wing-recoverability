<launch>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="paused" default="true"/>
  <arg name="voxel_resolution" default="2.0"/>
  <arg name="max_voxels" default="200000"/>
  <arg name="model_path" default="$(find motion_primitives_planning)/models/recovery_mlp.txt"/>
  <include file="$(find motion_primitives_planning)/launch/terminal_recovery_end_world_lidar.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="voxel_resolution" value="$(arg voxel_resolution)"/>
    <arg name="max_voxels" value="$(arg max_voxels)"/>
    <arg name="model_path" value="$(arg model_path)"/>
    <arg name="world_name" value="$(find simple_airplane_gazebo)/worlds/end_city_dense_lidar.world"/>
    <arg name="task_config" value="$(find motion_primitives_planning)/launch/config/task_end_city_dense.yaml"/>
  </include>
</launch>
