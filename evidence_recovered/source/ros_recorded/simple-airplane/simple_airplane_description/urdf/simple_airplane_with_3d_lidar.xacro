<?xml version="1.0"?>
<robot name="simple_airplane" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find simple_airplane_description)/urdf/simple_airplane.xacro"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>
  <link name="lidar">
    <visual name="lidar_housing">
      <geometry><cylinder radius="0.055" length="0.06"/></geometry>
      <material name="lidar_dark"><color rgba="0.1 0.12 0.15 1"/></material>
    </visual>
    <visual name="lidar_band">
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><cylinder radius="0.057" length="0.015"/></geometry>
      <material name="lidar_cyan"><color rgba="0 0.8 0.9 1"/></material>
    </visual>
  </link>
  <gazebo reference="lidar">
    <gravity>false</gravity>
    <sensor name="lidar_3d" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>5</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>512</samples><resolution>1</resolution>
            <min_angle>${-pi}</min_angle><max_angle>${pi-2*pi/512}</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples><resolution>1</resolution>
            <min_angle>${-40*pi/180}</min_angle><max_angle>${20*pi/180}</max_angle>
          </vertical>
        </scan>
        <range><min>1.0</min><max>120</max><resolution>0.01</resolution></range>
      </ray>
      <plugin name="lidar_pointcloud" filename="libgazebo_ros_3d_lidar.so">
        <robotNamespace>/suav1</robotNamespace>
        <topicName>lidar/points_raw</topicName>
        <frameName>suav1/lidar</frameName>
      </plugin>
    </sensor>
  </gazebo>
</robot>
